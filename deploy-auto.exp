#!/usr/bin/expect -f

# 自动化部署脚本（使用expect自动输入密码）

set server_ip "101.37.28.116"
set server_user "root"
set server_password "huangjianpei123@"
set deploy_path "/opt/3d-manage-backend"
set package_file "backend-deploy.tar.gz"

set timeout 300

puts "========================================="
puts "3D打印管理系统 - 自动化部署"
puts "服务器: $server_ip"
puts "========================================="
puts ""

# 检查打包文件
if {![file exists $package_file]} {
    puts "❌ 错误: 找不到打包文件 $package_file"
    puts "请先运行打包命令"
    exit 1
}

puts "✅ 找到打包文件: $package_file"
puts ""

# 步骤1: 上传文件
puts "步骤 1/5: 上传代码到服务器..."
spawn scp -o StrictHostKeyChecking=no $package_file $server_user@$server_ip:/tmp/
expect {
    "password:" {
        send "$server_password\r"
        expect eof
    }
    timeout {
        puts "❌ 上传超时"
        exit 1
    }
}

if {$expect_out(status) != 0} {
    puts "❌ 上传失败"
    exit 1
}
puts "✅ 上传完成"
puts ""

# 步骤2-5: 在服务器上执行部署
puts "步骤 2/5: 在服务器上配置环境..."
spawn ssh -o StrictHostKeyChecking=no $server_user@$server_ip
expect {
    "password:" {
        send "$server_password\r"
        expect "# "
    }
    timeout {
        puts "❌ 连接超时"
        exit 1
    }
}

# 执行部署命令
send "set -e\r"
expect "# "

send "DEPLOY_PATH=$deploy_path\r"
expect "# "

send "mkdir -p \$DEPLOY_PATH\r"
expect "# "

send "cd \$DEPLOY_PATH\r"
expect "# "

send "if [ -f /tmp/$package_file ]; then tar -xzf /tmp/$package_file && rm /tmp/$package_file; else echo '文件不存在'; exit 1; fi\r"
expect "# "

send "if ! command -v node &> /dev/null; then curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && apt-get install -y nodejs; fi\r"
expect "# "

send "npm install -g pm2 || true\r"
expect "# "

send "if [ ! -f .env ]; then cat > .env << 'ENVEOF'\nPORT=3001\nFRONTEND_URL=*\nJWT_SECRET=\$(openssl rand -base64 32)\nUPLOAD_DIR=./uploads\nAPI_BASE_URL=http://$server_ip:3001\nENVEOF\nfi\r"
expect "# "

send "mkdir -p uploads/models uploads/orders/attachments uploads/stock uploads/previews && chmod -R 755 uploads\r"
expect "# "

send "echo '步骤 3/5: 安装依赖...'\r"
expect "# "

send "npm install --production\r"
expect "# "

send "echo '步骤 4/5: 启动服务...'\r"
expect "# "

send "pm2 stop 3d-manage-api 2>/dev/null || true\r"
expect "# "

send "pm2 delete 3d-manage-api 2>/dev/null || true\r"
expect "# "

send "pm2 start server.js --name 3d-manage-api\r"
expect "# "

send "pm2 save\r"
expect "# "

send "pm2 startup | tail -1 | bash || true\r"
expect "# "

send "echo '步骤 5/5: 配置防火墙...'\r"
expect "# "

send "ufw allow 3001/tcp 2>/dev/null || firewall-cmd --permanent --add-port=3001/tcp 2>/dev/null || true\r"
expect "# "

send "ufw reload 2>/dev/null || firewall-cmd --reload 2>/dev/null || true\r"
expect "# "

send "echo '✅ 部署完成！'\r"
expect "# "

send "pm2 status\r"
expect "# "

send "sleep 2 && curl -s http://localhost:3001/health || echo '服务启动中...'\r"
expect "# "

send "exit\r"
expect eof

puts ""
puts "========================================="
puts "✅ 部署成功！"
puts "========================================="
puts ""
puts "📱 后端API地址: http://$server_ip:3001"
puts "🔍 查看服务状态: ssh $server_user@$server_ip 'pm2 status'"
puts "📋 查看日志: ssh $server_user@$server_ip 'pm2 logs 3d-manage-api'"
puts ""


